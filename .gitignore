/target
# Build output + lock of vendored crates built STANDALONE (e.g. ironrdp-rdpeudp,
# tested via `cargo test --manifest-path …`); the in-macrdp build uses the root.
vendor/*/target/
vendor/*/Cargo.lock
**/*.rs.bk
Cargo.lock.bak

# Self-signed dev certs that the server generates on first run
/dev-certs/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Local configuration and secrets (examples stay tracked)
**/.env
**/.env.*
!**/.env.example
/packaging/config.env

# Local logs and generated release bundles
*.log
*.log.*
/dist/*.tar.gz
/dist/*.tar.gz.sha256
/dist/*.zip
/dist/*.zip.sha256
/artifacts/
/out/

# macOS
.DS_Store

# Editors / local tooling
.idea/
.vscode/

# SwiftPM build output for the menu-bar controller (gui/)
/gui/.build/

# Soak run logs (scripts/soak-lossy.sh)
/soak-lossy-*.log
